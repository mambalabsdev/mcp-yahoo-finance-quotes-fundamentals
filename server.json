{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.mambabuilt/mcp-yahoo-finance-quotes-fundamentals",
  "description": "Yahoo Finance quotes, ratios, statements, price history, and dividends per ticker, no key",
  "version": "1.0.1",
  "repository": {
    "url": "https://github.com/mambalabsdev/mcp-yahoo-finance-quotes-fundamentals",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@mambalabsdev/mcp-yahoo-finance-quotes-fundamentals",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APIFY_TOKEN",
          "description": "Apify API token from https://console.apify.com/account/integrations",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
