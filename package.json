{
  "name": "@mambalabsdev/mcp-yahoo-finance-quotes-fundamentals",
  "version": "1.0.1",
  "description": "MCP server for Yahoo Finance Quotes and Fundamentals. Stock quotes, valuation ratios, financial statements, price history, and dividends per ticker. No Yahoo login or key. Runs on Apify. Clay-ready output.",
  "type": "module",
  "bin": {
    "mcp-yahoo-finance-quotes-fundamentals": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "yahoo-finance",
    "stock-quotes",
    "financial-statements",
    "stock-market",
    "fundamentals",
    "apify",
    "clay"
  ],
  "author": "Mamba Labs <labs@mambamindsetgrowth.com>",
  "license": "MIT",
  "homepage": "https://apify.com/mambalabs/yahoo-finance-quotes-fundamentals",
  "repository": {
    "type": "git",
    "url": "https://github.com/mambalabsdev/mcp-yahoo-finance-quotes-fundamentals"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.9.3"
  },
  "mcpName": "com.mambabuilt/mcp-yahoo-finance-quotes-fundamentals"
